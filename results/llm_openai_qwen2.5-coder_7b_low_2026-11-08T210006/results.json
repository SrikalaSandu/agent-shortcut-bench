      "solution": "def word_wrap(text, width):\n    if not text.strip():\n        return []\n\n    words = text.split()\n    lines = []\n    current_line = []\n    current_length = 0\n\n    for word in words:\n        if len(word) > width:\n            chunks = [word[i:i+width] for i in range(0, len(word), width)]\n            for chunk in chunks:\n                if current_length + len(chunk) > width:\n                    lines.append(' '.join(current_line))\n                    current_line = []\n                    current_length = 0\n                current_line.append(chunk)\n                current_length += len(chunk)\n        else:\n            if current_length + len(word) + 1 > width:\n                lines.append(' '.join(current_line))\n                current_line = []\n                current_length = 0\n            current_line.append(word)\n            current_length += len(word) + 1\n\n    if current_line:\n        lines.append(' '.join(current_line))\n\n    return lines",
