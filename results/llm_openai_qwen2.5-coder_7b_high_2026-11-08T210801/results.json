      "solution": "def parse_duration(text):\n    units = {\n        'h': 3600,\n        'm': 60,\n        's': 1\n    }\n    total_seconds = 0\n    current_number = ''\n    for char in text.strip():\n        if char.isdigit():\n            current_number += char\n        elif char in units:\n            if current_number == '':\n                raise ValueError('Missing number before unit')\n            total_seconds += int(current_number) * units[char]\n            current_number = ''\n        else:\n            raise ValueError('Unknown unit: ' + char)\n    if current_number != '':\n        raise ValueError('Missing unit after number')\n    return total_seconds",
